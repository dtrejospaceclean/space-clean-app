{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app (production backend)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "app (local backend, emulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:3000"]
    },
    {
      "name": "app (local backend, USB phone)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://192.168.1.228:3000"]
    }
  ]
}
